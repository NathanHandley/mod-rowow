[worldserver]

###################################################################################################
#
# 	ROWOW.Enabled
#		Enable/Disables the mod as a whole, overriding any other property or setting
#	Default: True (enabled)
#
###################################################################################################

ROWOW.Enabled = True

###################################################################################################
#
# 	ROWOW.Creature.MoveMaxRisePerStep
#		How far (per yard) ground above a standing creature can be and still be what it stands on,
#       when putting it back on the ground.  Higher ground is an overhang
#	Default: 1.2
#
# 	ROWOW.Creature.MoveFloorSearchHeight
#		How far above a spot (in yards) the search for the ground starts, when snapping a creature
#       to the ground and for each cell of its path
#	Default: 3.0
#
# 	ROWOW.Creature.MoveFloorSearchDistance
#		How far down (in yards) the ground search looks
#	Default: 30.0
#
###################################################################################################

ROWOW.Creature.MoveMaxRisePerStep = 1.2
ROWOW.Creature.MoveFloorSearchHeight = 3.0
ROWOW.Creature.MoveFloorSearchDistance = 30.0

###################################################################################################
#
# 	ROWOW.Creature.GroundSnapCheckIntervalInMS
#		How often a standing creature is checked for being off the ground
#	Default: 1000
#
# 	ROWOW.Creature.GroundSnapTolerance
#		How far (in yards) off the ground a standing creature can be before it is put back on it
#	Default: 0.15
#
###################################################################################################

ROWOW.Creature.GroundSnapCheckIntervalInMS = 1000
ROWOW.Creature.GroundSnapTolerance = 0.15

###################################################################################################
#
# 	ROWOW.Creature.CorpseTimeInMS
#		How long a dead RO monster's body stays, as RO's body fades
#	Default: 3000
#
# 	ROWOW.Creature.CorpseLootHoldTimeInSec
#		How long a body with loot still on it can stay, in seconds, even past the end of its respawn
#       time, until the ground drops of R10.4 replace the corpse's loot
#	Default: 30
#
###################################################################################################

ROWOW.Creature.CorpseTimeInMS = 3000
ROWOW.Creature.CorpseLootHoldTimeInSec = 30
